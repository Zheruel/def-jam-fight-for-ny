+#ifdef __EMSCRIPTEN__
+void CPS2VM::SetBrowserPaused(bool paused)
+{
+	// Preserve the order of visibility changes even if the VM is busy loading a stage.
+	m_mailBox.SendCall([this, paused]() {
+		if(paused) PauseImpl();
+		else ResumeImpl();
+	});
+}
+#endif
