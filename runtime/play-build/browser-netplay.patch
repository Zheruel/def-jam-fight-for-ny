+using Controller = PS2::CControllerInfo;
+constexpr std::array<Controller::BUTTON, 16> GAMEPAD_BUTTONS = {
+    Controller::CROSS, Controller::CIRCLE, Controller::SQUARE, Controller::TRIANGLE,
+    Controller::L1, Controller::R1, Controller::L2, Controller::R2,
+    Controller::SELECT, Controller::START, Controller::L3, Controller::R3,
+    Controller::DPAD_UP, Controller::DPAD_DOWN, Controller::DPAD_LEFT, Controller::DPAD_RIGHT};
+constexpr std::array<Controller::BUTTON, 4> GAMEPAD_AXES = {
+    Controller::ANALOG_LEFT_X, Controller::ANALOG_LEFT_Y,
+    Controller::ANALOG_RIGHT_X, Controller::ANALOG_RIGHT_Y};
+
+uint8 AxisByte(float value)
+{
+	if(!std::isfinite(value)) value = 0;
+	return static_cast<uint8>((std::clamp(value, -1.0f, 1.0f) + 1.0f) * 127.5f);
+}
+
+class CBrowserPadHandler final : public CPH_GenericInput
+{
+public:
+	void SetPad(unsigned int port, uint32 buttons, const std::array<float, 4>& axes)
+	{
+		if(port >= m_states.size()) return;
+		PadState state;
+		state.active = true;
+		state.buttons = buttons & 0xFFFF;
+		std::transform(axes.begin(), axes.end(), state.axes.begin(), AxisByte);
+		const std::lock_guard<std::mutex> lock(m_stateMutex);
+		m_states[port] = state;
+	}
+
+	int GetReadback(unsigned int port) const
+	{
+		if(port >= m_readback.size()) return -1;
+		return m_readback[port].load(std::memory_order_relaxed);
+	}
+
+	void Update(uint8* ram) override
+	{
+		// Keep the upstream canvas keyboard bindings when a port is not driven by JS.
+		CPH_GenericInput::Update(ram);
+		std::array<PadState, 2> states;
+		{
+			const std::lock_guard<std::mutex> lock(m_stateMutex);
+			states = m_states;
+		}
+		for(auto* interface : m_interfaces)
+		{
+			for(unsigned int port = 0; port < states.size(); port++)
+			{
+				const auto& state = states[port];
+				if(!state.active) continue;
+				for(unsigned int i = 0; i < GAMEPAD_AXES.size(); i++)
+				{
+					interface->SetAxisState(port, GAMEPAD_AXES[i], state.axes[i], ram);
+				}
+				for(unsigned int i = 0; i < GAMEPAD_BUTTONS.size(); i++)
+				{
+					interface->SetButtonState(port, GAMEPAD_BUTTONS[i], (state.buttons & (1U << i)) != 0, ram);
+				}
+				m_readback[port].store(state.buttons, std::memory_order_relaxed);
+			}
+		}
+	}
+
+private:
+	struct PadState
+	{
+		bool active = false;
+		uint32 buttons = 0;
+		std::array<uint8, 4> axes = {};
+	};
+	std::mutex m_stateMutex;
+	std::array<PadState, 2> m_states;
+	std::array<std::atomic<int>, 2> m_readback = {-1, -1};
+};
+}
+
+EM_JS_DEPS(playAudio, "$AL");
+EM_JS(void, installPlayAudioExports, (), {
+	const openal = AL.currentCtx;
+	if(!openal) return;
+	const context = openal.audioCtx;
+	const speakers = context.createGain();
+	openal.gain.disconnect(context.destination);
+	openal.gain.connect(speakers);
+	speakers.connect(context.destination);
+
+	let capture;
+	Module["getPlayAudioStream"] = () => {
+		if(!capture)
+		{
+			capture = context.createMediaStreamDestination();
+			openal.gain.connect(capture);
+		}
+		return capture.stream;
+	};
+	Module["resumePlayAudio"] = () => context.resume();
+	Module["setPlayAudioMuted"] = (muted) => {
+		speakers.gain.setTargetAtTime(muted ? 0 : 1, context.currentTime, 0.015);
+	};
+});
