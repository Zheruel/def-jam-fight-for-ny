{
  "name": "def-jam-fight-for-ny",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node tools/serve.mjs",
    "test": "node --test tests/*.test.mjs ps2/battle/tests/*.test.mjs ps2/content/tests/*.test.mjs",
    "disc": "python3 tools/disc.py private/ps2/reference.iso --output private/ps2/reference.json",
    "setup": "npm ci --prefix netplay",
    "test:netplay": "npm --prefix netplay test",
    "test:match": "node verification/ps2-match.mjs"
  }
}
