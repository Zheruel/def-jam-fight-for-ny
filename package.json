{
  "name": "def-jam-fight-for-ny",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node tools/serve.mjs",
    "test": "node --test tests/*.test.mjs ps2/battle/tests/*.test.mjs ps2/content/tests/*.test.mjs port/battle/cpu.test.mjs port/combat/*.test.mjs port/assets/*.test.mjs port/motion/*.test.mjs port/collision/*.test.mjs port/fighters/*.test.mjs port/audio/*.test.mjs port/scenery/*.test.mjs",
    "disc": "python3 tools/disc.py private/ps2/reference.iso --output private/ps2/reference.json",
    "setup": "npm ci --prefix netplay",
    "test:netplay": "npm --prefix netplay test",
    "test:match": "node verification/ps2-match.mjs",
    "test:native-menu": "node verification/native-menu-browser.mjs",
    "test:native-result-browser": "node verification/native-result-browser.mjs",
    "test:native-team": "node verification/native-team.mjs",
    "test:native-three": "node verification/native-four.mjs --three",
    "test:native-four": "node verification/native-four.mjs",
    "test:native-outcome": "node verification/native-outcome.mjs",
    "test:native-venue": "node verification/native-venue.mjs",
    "test:native-battle": "node verification/native-combat.mjs && node verification/native-roster.mjs && node verification/native-battle.mjs",
    "test:native-damage": "node verification/native-damage.mjs",
    "test:native-animation": "node verification/native-animation.mjs"
  }
}
